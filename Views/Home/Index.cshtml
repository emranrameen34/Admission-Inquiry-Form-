@{
    ViewData["Title"] = "Portal Selection";
}

<!-- Include Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container text-center mt-5">

    <!-- University Logo and Name -->
    <div class="mb-5">
        <img src="~/images/USP 2.png" alt="University Logo" style="height:80px;" class="mb-3">
        <h1 class="fw-bold text-primary">University of Southern Punjab </h1> 
        <h2 class="fw-bold text-primary">
            Admission Inquiry Record Portal
        </h2>
        <hr class="mx-auto" style="width: 250px; border: 2px solid #0d6efd;">
    </div>

    <!-- Buttons Section -->
    <div class="d-flex flex-column align-items-center gap-4">

        <a asp-controller="Person" asp-action="Create"
           class="btn btn-primary btn-lg shadow-lg fw-bold w-50"
           style="border-radius: 12px; transition: transform 0.2s;">
            Add Inquiry
        </a>

        <a asp-controller="Counselling" asp-action="Login"
           class="btn btn-success btn-lg shadow-lg fw-bold w-50"
           style="border-radius: 12px; transition: transform 0.2s;">
            Counsellor Panel
        </a>

    </div>
</div>

<!-- Optional hover effect -->
<script>
    const buttons = document.querySelectorAll(".btn");
    buttons.forEach(btn => {
        btn.addEventListener("mouseenter", () => btn.style.transform = "scale(1.05)");
        btn.addEventListener("mouseleave", () => btn.style.transform = "scale(1)");
    });
</script>