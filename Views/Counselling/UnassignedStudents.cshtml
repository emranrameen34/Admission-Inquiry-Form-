@model List<AdmissionInquiryRecord.Models.Person>
@{
    ViewData["Title"] = "Unassigned Students";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-warning">🆕 Unassigned Students</h2>
        <hr style="width:250px; margin:10px auto; border:2px solid #ffc107;" />
    </div>

    <!-- Top Buttons -->
    <div class="text-center mb-4">
        <a href="@Url.Action("UnassignedStudents")" class="btn btn-warning mx-1">🆕 Unassigned Students</a>
        <a href="@Url.Action("AssignedStudents")" class="btn btn-primary mx-1">👤 Assigned Students</a>
        <a href="@Url.Action("AlreadyCounselled")" class="btn btn-success mx-1">✅ Already Counselled</a>
    </div>

    @if (Model.Any())
    {
        <ul class="list-group shadow">
            @foreach (var student in Model)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@student.Name</strong><br />
                        Visit No: @student.VisitNo | ID: @student.PersonId
                    </div>
                    <div>
                        <!-- Assign button -->
                        <a asp-action="Assign" asp-route-personId="@student.PersonId" class="btn btn-warning btn-sm me-1">Assign To Me</a>

                        <!-- Do Counselling button: disable if not assigned -->
                        @if (student.CounsellorId != null && student.CounsellorId != 0)
                        {
                            <a asp-action="Create" asp-route-personId="@student.PersonId" class="btn btn-success btn-sm">Do Counselling</a>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-sm" disabled>Assign first</button>
                        }
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="alert alert-light text-center">No unassigned students available.</div>
    }
</div>