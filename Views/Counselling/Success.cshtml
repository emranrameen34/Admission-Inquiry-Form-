@{
    ViewData["Title"] = "Counselling Saved";
    var counsellingCode = TempData["CounsellingCode"];
    var personName = TempData["PersonName"];
    var entryDate = TempData["EntryDate"];
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(135deg, #e3f2fd, #f1f8e9);
    }

    .success-card {
        border-radius: 20px;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        padding: 20px;
    }

    .success-icon {
        font-size: 60px;
        color: #28a745;
    }

    .btn-dashboard {
        background-color: #0d6efd;
        border: none;
    }

        .btn-dashboard:hover {
            background-color: #084298;
        }

    .btn-add {
        background-color: #20c997;
        border: none;
        color: white;
    }

        .btn-add:hover {
            background-color: #146c43;
        }

    .btn-home {
        background-color: #6f42c1;
        border: none;
        color: white;
    }

        .btn-home:hover {
            background-color: #4e2a8e;
        }

    .info-box p {
        font-size: 16px;
        margin-bottom: 8px;
    }
</style>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">

    <div class="card success-card text-center" style="max-width:500px; width:100%;">

        <div class="card-body">

            <div class="success-icon mb-3">
                ✔
            </div>

            <h2 class="fw-bold text-success">
                Counselling Record Saved!
            </h2>

            <p class="text-muted mb-4">
                The counselling information has been successfully recorded.
            </p>

            <div class="info-box text-start bg-light rounded p-3 mb-4">
                <p><strong>📌 Counselling ID:</strong> @counsellingCode</p>
                <p><strong>👤 Student Name:</strong> @personName</p>
                <p><strong>📅 Entry Date:</strong> @entryDate</p>
            </div>

            <div class="d-grid gap-2">

                <a href="/Counselling/Dashboard"
                   class="btn btn-dashboard btn-lg text-white">
                    Go to Dashboard
                </a>

                

                <a href="/Home/Index"
                   class="btn btn-home btn-lg">
                    Go to Home
                </a>

            </div>

        </div>
    </div>

</div>