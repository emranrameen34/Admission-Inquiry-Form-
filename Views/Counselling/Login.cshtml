@{
    ViewData["Title"] = "Counsellor Login";
}

<!-- Include Bootstrap CSS & jQuery (from CDN) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white text-center">
                    <h3>Counsellor Login</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Login" method="post" id="loginForm">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email:</label>
                            <input type="email" class="form-control" name="email" id="email" placeholder="Enter your email" required />
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Password:</label>
                            <input type="password" class="form-control" name="password" id="password" placeholder="Enter your password" required />
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Login</button>
                        </div>
                    </form>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mt-3" role="alert">
                            @ViewBag.Error
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Optional: Simple jQuery effect -->
<script>
    $(document).ready(function () {
        $('#loginForm').on('submit', function () {
            // Disable button on submit to prevent double click
            $(this).find('button[type="submit"]').attr('disabled', true).text('Logging in...');
        });
    });
</script>