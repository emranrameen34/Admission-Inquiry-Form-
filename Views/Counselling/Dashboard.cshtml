@{
    ViewData["Title"] = "Counsellor Dashboard";

    // Only assigned students to this counsellor
    var assignedStudents = ViewBag.AssignedStudents as List<AdmissionInquiryRecord.Models.Person> ?? new List<AdmissionInquiryRecord.Models.Person>();
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">

    <div class="text-center mb-4">
        <h1 class="fw-bold text-primary">Counsellor Dashboard</h1>
        <p class="lead">Welcome, <span class="text-success fw-semibold">@ViewBag.CounsellorName</span></p>
        <hr style="width:200px; margin:10px auto; border:2px solid #0d6efd;" />
    </div>

    <!-- ================= TOP BUTTONS ================= -->
    <div class="text-center mb-4">
        <a href="@Url.Action("UnassignedStudents")" class="btn btn-warning mx-1">🆕 Unassigned Students</a>
        <a href="@Url.Action("AssignedStudents")" class="btn btn-primary mx-1">👤 Assigned Students</a>
        <a href="@Url.Action("AlreadyCounselled")" class="btn btn-success mx-1">✅ Already Counselled</a>
    </div>

    <!-- ================= ASSIGNED STUDENTS ================= -->
    <h3 class="text-primary mb-3">👤 My Assigned Students</h3>

    @if (assignedStudents.Any())
    {
        <ul class="list-group shadow">
            @foreach (var student in assignedStudents)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@student.Name</strong><br />
                        Visit No: @student.VisitNo | ID: @student.PersonId
                    </div>
                    <a asp-action="Create" asp-route-personId="@student.PersonId" class="btn btn-success btn-sm">
                        Start Counselling
                    </a>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="alert alert-light text-center">No assigned students yet.</div>
    }

</div>